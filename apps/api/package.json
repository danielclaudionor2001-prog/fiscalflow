{
  "name": "@fiscalflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/health.test.ts test/credentials.test.ts test/fiscal.test.ts",
    "test:db": "node --test test/tenant-constraints.test.ts test/auth.test.ts test/registrations.test.ts",
    "auth:provision": "node src/auth/provision.ts",
    "nfse:homologacao": "node src/fiscal/cli.ts",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "libxml2-wasm": "0.7.2",
    "node-forge": "1.4.3",
    "pdfkit": "^0.20.2",
    "xml-crypto": "6.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/node-forge": "1.3.14",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^6.19.0",
    "typescript": "^5.8.2"
  }
}
