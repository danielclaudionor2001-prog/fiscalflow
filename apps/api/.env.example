# Valores de exemplo para uso exclusivamente local.
API_HOST=127.0.0.1
NODE_ENV=development
PORT=3333
WEB_ORIGIN=http://127.0.0.1:5173
# Use apenas IPs de proxies de entrada sob seu controle.
TRUSTED_PROXY_IPS=
# Injete uma chave aleatória de 32 bytes em base64url por um gerenciador de segredos.
FISCAL_CERTIFICATE_KEY=
# Caminho de um PEM com raízes ICP-Brasil confiáveis.
FISCAL_CERTIFICATE_ROOTS_FILE=
# Opcional. Caminho de um PEM com certificados intermediários ICP-Brasil.
FISCAL_CERTIFICATE_INTERMEDIATES_FILE=
# Opcional. Caminho absoluto da configuração protegida da Celcoin BaaS Sandbox.
CELCOIN_SANDBOX_CONFIG_FILE=
POSTGRES_PASSWORD=fiscalflow-local-only
DATABASE_URL=postgresql://fiscalflow:fiscalflow-local-only@127.0.0.1:5432/fiscalflow?schema=public&connect_timeout=3&pool_timeout=3
