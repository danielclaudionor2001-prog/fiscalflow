generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  OPERATOR
  ACCOUNTANT
  VIEWER
}

enum AuthAuditAction {
  MEMBERSHIP_PROVISIONED
  SESSION_STARTED
  SESSION_ENDED
}

enum RegistrationEntity {
  ORGANIZATION
  CUSTOMER
  SERVICE
  INVOICE
  MEMBERSHIP
  INVOICE_SCHEDULE
  FISCAL_CERTIFICATE
  PREPARED_DPS
  RECEIVING_ACCOUNT
  BOLETO
  CELCOIN_SANDBOX
  SUPPLIER
  PRODUCT
  STOCK_MOVEMENT
  COMMERCIAL_ORDER
  CASH_ENTRY
  CASH_PAYMENT
}

enum RegistrationAction {
  CREATED
  UPDATED
  ARCHIVED
  ACCESS_SUSPENDED
  ACCESS_REACTIVATED
}

enum InvoiceStatus {
  DRAFT
  QUEUED
  PROCESSING
  AUTHORIZED
  REJECTED
  CANCEL_REQUESTED
  CANCELLED
  FAILED
}

enum InvoiceKind {
  AVULSA
  MENSALIDADE
  MODERNIZACAO
  ORCAMENTO
}

enum BillingPurpose {
  SERVICE
  SUBSCRIPTION
}

enum ReceivingProvider {
  CELCOIN
  OWN_BANK
}

enum BoletoStatus {
  PLANNED
  REGISTERED
  SETTLED
  CANCELLED
}

enum CelcoinSandboxStatus {
  AWAITING_LOOKUP
  PROCESSING
  PENDING
  CONFIRMED
  CANCELED
  ERROR
}

model Organization {
  id                      String                   @id @default(cuid())
  legalName               String
  tradeName               String?
  cnpj                    String?                  @unique
  cpf                     String?                  @unique
  municipalRegistration   String?
  cityIbgeCode            String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  archivedAt              DateTime?
  accessSuspendedAt       DateTime?
  memberships             Membership[]
  accessInvitation        OrganizationInvitation?
  customers               Customer[]
  services                Service[]
  invoices                Invoice[]
  invoiceSchedules        InvoiceSchedule[]
  fiscalCertificate       FiscalCertificate?
  preparedDps             PreparedDps[]
  receivingAccounts       ReceivingAccount[]
  boletos                 Boleto[]
  authAuditEvents         AuthAuditEvent[]
  registrationAuditEvents RegistrationAuditEvent[]
  suppliers                Supplier[]
  products                 Product[]
  commercialOrders         CommercialOrder[]
  cashEntries              CashEntry[]
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           Role         @default(OPERATOR)
  platformOwner  Boolean      @default(false)
  loginCpf       String?
  user           User         @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  sessions       Session[]

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model OrganizationInvitation {
  organizationId String       @id
  tokenHash      String       @unique
  email          String
  name           String
  expiresAt      DateTime
  platformOwner  Boolean      @default(false)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Session {
  id             String     @id @default(cuid())
  tokenHash      String     @unique
  userId         String
  organizationId String
  createdAt      DateTime   @default(now())
  lastSeenAt     DateTime   @default(now())
  expiresAt      DateTime
  membership     Membership @relation(fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  @@index([organizationId, userId])
  @@index([expiresAt])
}

model AuthAuditEvent {
  id             String          @id @default(cuid())
  organizationId String
  userId         String
  action         AuthAuditAction
  createdAt      DateTime        @default(now())
  organization   Organization    @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
}

model RegistrationAuditEvent {
  id             String             @id @default(cuid())
  organizationId String
  actorUserId    String?
  entity         RegistrationEntity
  entityId       String
  action         RegistrationAction
  createdAt      DateTime           @default(now())
  organization   Organization       @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  federalTaxId   String
  email          String?
  phone          String?
  createdAt      DateTime     @default(now())
  archivedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])
  invoices       Invoice[]
  invoiceSchedules InvoiceSchedule[]
  commercialOrders CommercialOrder[]

  @@unique([organizationId, id])
  @@unique([organizationId, federalTaxId])
  @@index([organizationId, name])
}

model Service {
  id                   String       @id @default(cuid())
  organizationId       String
  name                 String
  description          String
  nationalServiceCode  String?
  municipalServiceCode String?
  defaultAmount        Decimal      @db.Decimal(14, 2)
  active               Boolean      @default(true)
  archivedAt           DateTime?
  organization         Organization @relation(fields: [organizationId], references: [id])
  invoices             Invoice[]
  invoiceSchedules     InvoiceSchedule[]
  commercialItems CommercialItem[]

  @@unique([organizationId, id])
  @@index([organizationId])
}

model Invoice {
  id                 String        @id @default(cuid())
  organizationId     String
  customerId         String
  serviceId          String?
  status             InvoiceStatus @default(DRAFT)
  kind               InvoiceKind   @default(AVULSA)
  idempotencyKey     String
  amount             Decimal       @db.Decimal(14, 2)
  serviceDescription String
  accessKey          String?
  rejectionReason    String?
  xmlRequest         String?
  xmlResponse        String?
  authorizedAt       DateTime?
  discardedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  organization       Organization  @relation(fields: [organizationId], references: [id])
  customer           Customer      @relation(fields: [organizationId, customerId], references: [organizationId, id])
  service            Service?      @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Restrict)
  schedules          InvoiceSchedule[]
  preparedDps        PreparedDps[]
  boleto             Boleto?
  commercialOrder CommercialOrder?

  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, status, authorizedAt])
}

model InvoiceSchedule {
  id                 String       @id @default(cuid())
  organizationId     String
  sourceInvoiceId    String?
  customerId         String
  serviceId          String?
  amount             Decimal      @db.Decimal(14, 2)
  serviceDescription String
  dayOfMonth         Int
  kind               InvoiceKind  @default(MENSALIDADE)
  nextRunAt          DateTime?
  lastRunAt          DateTime?
  pauseReason        String?
  organization       Organization @relation(fields: [organizationId], references: [id])
  sourceInvoice      Invoice?     @relation(fields: [organizationId, sourceInvoiceId], references: [organizationId, id], onDelete: Restrict)
  customer           Customer     @relation(fields: [organizationId, customerId], references: [organizationId, id])
  service            Service?     @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, sourceInvoiceId])
  @@index([nextRunAt, id])
}

model FiscalCertificate {
  organizationId String       @id
  version        String       @unique
  fingerprint    String
  validFrom      DateTime
  validUntil     DateTime
  savedAt        DateTime
  sealed         Bytes
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model PreparedDps {
  organizationId     String
  id                 String
  invoiceId          String
  invoiceVersion     DateTime
  certificateVersion String
  inputHash          String
  signedXml          Bytes
  preparedAt         DateTime     @default(now())
  organization       Organization @relation(fields: [organizationId], references: [id])
  invoice            Invoice      @relation(fields: [organizationId, invoiceId], references: [organizationId, id])

  @@id([organizationId, id])
  @@index([organizationId, invoiceId, preparedAt])
}

model ReceivingAccount {
  organizationId String
  purpose        BillingPurpose
  provider       ReceivingProvider
  bankName       String
  bankCode       String?
  branch         String?
  accountNumber  String
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id])

  @@id([organizationId, purpose])
}

model Boleto {
  id                  String            @id @default(cuid())
  organizationId      String
  purpose             BillingPurpose
  invoiceId           String?
  period              String?
  payerName           String
  amount              Decimal           @db.Decimal(14, 2)
  dueDate             DateTime          @db.Date
  status              BoletoStatus      @default(PLANNED)
  bankName            String
  accountLastFour     String
  provider            ReceivingProvider
  issuerReference     String?
  settledAt           DateTime?
  createdAt           DateTime          @default(now())
  organization        Organization      @relation(fields: [organizationId], references: [id])
  invoice             Invoice?          @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Restrict)
  sandbox             CelcoinSandboxCharge?

  @@unique([organizationId, id])
  @@unique([organizationId, invoiceId])
  @@unique([organizationId, period])
  @@index([organizationId, purpose, createdAt, id])
}

model CelcoinSandboxCharge {
  organizationId        String
  boletoId              String
  externalId            String               @unique
  receiverFingerprint   String
  transactionId         String?
  status                CelcoinSandboxStatus @default(AWAITING_LOOKUP)
  bankLine              String?
  dueDate               DateTime             @db.Date
  version               Int                  @default(0)
  updatedAt             DateTime             @updatedAt
  boleto                Boleto               @relation(fields: [organizationId, boletoId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, boletoId])
}

enum CommercialKind {
  QUOTE
  SERVICE_ORDER
  SALE
}

enum CommercialStatus {
  OPEN
  CONFIRMED
  CANCELLED
}

enum CashKind {
  RECEIVABLE
  PAYABLE
  COMMISSION
}

enum PaymentMethod {
  PIX
  CASH
  CARD
  BOLETO
  TRANSFER
  OTHER
}

model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  federalTaxId   String?
  email          String?
  phone          String?
  archivedAt     DateTime?
  products       Product[]
  cashEntries    CashEntry[]

  @@unique([organizationId, id])
  @@index([organizationId, archivedAt, name])
}

model Product {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  sku            String
  name           String
  price          Decimal          @db.Decimal(14, 2)
  cost           Decimal          @db.Decimal(14, 2)
  stock          Int              @default(0)
  minimumStock   Int              @default(0)
  supplierId     String?
  supplier       Supplier?        @relation(fields: [organizationId, supplierId], references: [organizationId, id])
  archivedAt     DateTime?
  items          CommercialItem[]
  movements      StockMovement[]

  @@unique([organizationId, id])
  @@unique([organizationId, sku])
  @@index([organizationId, archivedAt, name])
}

model StockMovement {
  id             String           @id @default(cuid())
  organizationId String
  productId      String
  product        Product          @relation(fields: [organizationId, productId], references: [organizationId, id])
  orderId        String?
  order          CommercialOrder? @relation(fields: [organizationId, orderId], references: [organizationId, id])
  quantity       Int
  reason         String
  requestKey     String?
  createdAt      DateTime         @default(now())

  @@unique([organizationId, requestKey])
  @@index([organizationId, productId, createdAt])
}

model CommercialOrder {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  kind           CommercialKind
  status         CommercialStatus @default(OPEN)
  customerId     String?
  customer       Customer?        @relation(fields: [organizationId, customerId], references: [organizationId, id])
  customerName   String?
  sourceId       String?
  source         CommercialOrder? @relation("OrderConversion", fields: [organizationId, sourceId], references: [organizationId, id])
  convertedSale  CommercialOrder? @relation("OrderConversion")
  invoiceId      String?
  invoice        Invoice?         @relation(fields: [organizationId, invoiceId], references: [organizationId, id])
  note           String
  sellerName     String?
  commissionBps  Int              @default(0)
  installments   Int              @default(1)
  dueOn          DateTime?        @db.Date
  amount         Decimal          @db.Decimal(14, 2)
  cost           Decimal          @db.Decimal(14, 2)
  requestKey     String?
  requestHash    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  confirmedAt    DateTime?
  items          CommercialItem[]
  movements      StockMovement[]
  cashEntries    CashEntry[]

  @@unique([organizationId, id])
  @@unique([organizationId, sourceId])
  @@unique([organizationId, invoiceId])
  @@unique([organizationId, requestKey])
  @@index([organizationId, kind, createdAt])
  @@index([organizationId, kind, status, confirmedAt])
}

model CommercialItem {
  id             String          @id @default(cuid())
  organizationId String
  orderId        String
  order          CommercialOrder @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Cascade)
  productId      String?
  product        Product?        @relation(fields: [organizationId, productId], references: [organizationId, id])
  serviceId      String?
  service        Service?        @relation(fields: [organizationId, serviceId], references: [organizationId, id])
  label          String
  quantity       Int
  unitPrice      Decimal         @db.Decimal(14, 2)
  unitCost       Decimal         @db.Decimal(14, 2)
  position       Int

  @@unique([organizationId, orderId, position])
}

model CashEntry {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  orderId        String?
  order          CommercialOrder? @relation(fields: [organizationId, orderId], references: [organizationId, id])
  supplierId     String?
  supplier       Supplier?        @relation(fields: [organizationId, supplierId], references: [organizationId, id])
  kind           CashKind
  description    String
  amount         Decimal          @db.Decimal(14, 2)
  balance        Decimal          @db.Decimal(14, 2)
  dueOn          DateTime         @db.Date
  requestKey     String?
  requestHash    String?
  cancelledAt    DateTime?
  createdAt      DateTime         @default(now())
  payments       CashPayment[]

  installment Int @default(1)

  @@unique([organizationId, id])
  @@unique([organizationId, orderId, kind, installment])
  @@unique([organizationId, requestKey])
  @@index([organizationId, cancelledAt, dueOn])
}

model CashPayment {
  id             String        @id @default(cuid())
  organizationId String
  entryId        String
  entry          CashEntry     @relation(fields: [organizationId, entryId], references: [organizationId, id])
  amount         Decimal       @db.Decimal(14, 2)
  paidOn         DateTime      @db.Date
  method         PaymentMethod
  requestKey     String
  createdAt      DateTime      @default(now())

  reversedAt DateTime?

  @@unique([organizationId, requestKey])
  @@index([organizationId, paidOn])
  @@index([organizationId, entryId, paidOn])
}
